typeset -gA ZSH_HIGHLIGHT_STYLES

ZSH_HIGHLIGHT_STYLES[default]=fg=#fafafa
ZSH_HIGHLIGHT_STYLES[unknown-token]=fg=#d4a017
ZSH_HIGHLIGHT_STYLES[reserved-word]=fg=#c678dd,bold
ZSH_HIGHLIGHT_STYLES[suffix-alias]=fg=#7a7a7a,underline
ZSH_HIGHLIGHT_STYLES[globbing]=fg=#c678dd
ZSH_HIGHLIGHT_STYLES[history-expansion]=fg=#fff2af,bold
ZSH_HIGHLIGHT_STYLES[commandseparator]=fg=#79a0aa
ZSH_HIGHLIGHT_STYLES[path]=fg=#fafafa
ZSH_HIGHLIGHT_STYLES[path_pathseparator]=fg=#fafafa
ZSH_HIGHLIGHT_STYLES[tilde]=fg=#fafafa
ZSH_HIGHLIGHT_STYLES[bracket-level-1]=fg=#ffbe89,bold
ZSH_HIGHLIGHT_STYLES[bracket-level-2]=fg=#79a0aa,bold
ZSH_HIGHLIGHT_STYLES[bracket-level-3]=fg=#c678dd,bold

# Command types
ZSH_HIGHLIGHT_STYLES[command]=fg=#d4a76a,bold
ZSH_HIGHLIGHT_STYLES[builtin]=fg=#d4a76a,bold
ZSH_HIGHLIGHT_STYLES[function]=fg=#d4a76a,bold
ZSH_HIGHLIGHT_STYLES[alias]=fg=#d4a76a,bold,underline

# Variables and substitutions
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-variable]=fg=#bf616a
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]=fg=#96a8ad
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]=fg=#a8c4c4

# Comments (enable only if desired)
ZSH_HIGHLIGHT_STYLES[comment]=fg=#5d6d7e,italic

# Quoted arguments
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]=fg=#9db89c
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]=fg=#9db89c
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]=fg=#bc735c
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]=fg=#c678dd

# Assignment highlight
ZSH_HIGHLIGHT_STYLES[assign]=fg=#ffbe89
